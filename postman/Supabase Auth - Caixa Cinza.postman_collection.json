{
  "info": {
    "_postman_id": "3007764b-d164-41e3-a399-9f341aa23446",
    "name": "Supabase Auth - Caixa Cinza",
    "description": "Testes de caixa cinza no endpoint de login do Supabase.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "59715436",
    "_collection_link": "https://go.postman.co/collection/59715436-3007764b-d164-41e3-a399-9f341aa23446?source=collection_link"
  },
  "item": [
    {
      "name": "CT01 - Login valido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code é 200', function () {\n    pm.response.to.have.status(200);\n});\npm.test('Resposta contém access_token', function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData).to.have.property('access_token');\n    pm.environment.set('access_token', jsonData.access_token);\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{api_key}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"{{email}}\",\r\n  \"password\": \"{{password}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/v1/token?grant_type=password",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "token"
          ],
          "query": [
            {
              "key": "grant_type",
              "value": "password"
            }
          ]
        }
      },
      "response": []
    },
    {
